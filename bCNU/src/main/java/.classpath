<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path=""/>
	<classpathentry combineaccessrules="false" kind="src" path="/magfield"/>
	<classpathentry combineaccessrules="false" kind="src" path="/swimmer"/>
	<classpathentry combineaccessrules="false" kind="src" path="/splot"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="lib" path="lib/bcnuimages.jar"/>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
