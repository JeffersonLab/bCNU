<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.heddle</groupId>
        <artifactId>ced-modernization</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ced</artifactId>
    <name>CLAS12 Event Display</name>

    <dependencies>
        <dependency>
            <groupId>io.github.heddle</groupId>
            <artifactId>bcnu</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.heddle</groupId>
            <artifactId>bcnu3d</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>cnuphys</groupId>
            <artifactId>snr</artifactId>
            <version>13.7.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.jlab.clas</groupId>
            <artifactId>coat-libs</artifactId>
            <version>13.7.1</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ced</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <mainClass>cnuphys.ced.frame.Ced</mainClass>
                    <systemProperties>
                        <systemProperty>
                            <key>CLAS12DIR</key>
                            <value>${project.basedir}/../coatjava</value>
                        </systemProperty>
                        <systemProperty>
                            <key>sun.java2d.pmoffscreen</key>
                            <value>false</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <classpathPrefix>lib/</classpathPrefix>
                            <mainClass>cnuphys.ced.frame.Ced</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
